{
  "name": "@caiae/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @caiae/core && npm run build -w @caiae/db && npm run build -w @caiae/authorization",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @caiae/core && npm run build -w @caiae/db && npm run build -w @caiae/authorization",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@caiae/db": "*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "@caiae/authorization": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  }
}
