# Core database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caiae

# Process environment
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CAIAE_RELEASE_SHA=development
CAIAE_RUN_MIGRATIONS=true
CAIAE_SHUTDOWN_GRACE_MS=15000

# API network boundary
CAIAE_CORS_ORIGINS=*
CAIAE_TRUST_PROXY=false
CAIAE_BODY_LIMIT_BYTES=1048576
CAIAE_REQUEST_TIMEOUT_MS=30000
CAIAE_API_SECURITY_MODE=enforce
CAIAE_BOOTSTRAP_SECRET=
CAIAE_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Worker sweep cadence
AUTHORIZATION_SWEEP_MS=30000
EXCEPTION_SWEEP_MS=30000
DEADLINE_SWEEP_MS=30000
EVALUATION_SWEEP_MS=30000
CERTIFICATION_SWEEP_MS=30000
WEBHOOK_SWEEP_MS=30000

# Development-only placeholder. Production requires a unique random secret
# containing at least 32 characters.
CAIAE_WEBHOOK_MASTER_SECRET=replace-with-a-long-random-secret
